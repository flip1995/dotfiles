[user]
	email = hello@philkrones.com
	name = Philipp Krones
	signingkey = 1CA0DF2AF59D68A5
[commit]
	gpgsign = true
[push]
	autoSetupRemote = true
[core]
	excludesfile = ~/.gitignore
	pager = delta
[url "git@github.com:"]
	pushInsteadOf = https://github.com/
[branch]
	sort = -committerdate
[rebase]
	updateRefs = true
[rerere]
	enabled = true
	autoupdate = true
[alias]
	corig = clean **/*.orig *.orig -f
	wip = commit -a -m "WIP"
	pushfwl = push --force-with-lease --force-if-includes
	drop = "!f() { git reset --keep HEAD~${1:-1}; }; f"
	resorig = "!f() { git reset --keep $(git rev-parse --abbrev-ref --symbolic-full-name @{u}); }; f"
	canpf = "!f() { git commit --amend --no-edit && git pushfwl; }; f"
	cpsha = "!f() { git log -1 --format=%H HEAD~${1:-0} | wl-copy; }; f"
	ghc = "!f() { mkdir -p ${1} && git clone git@github.com:${1} ${1}; }; f"
	gone = gone
	rad = rad
	unwip = unwip
[maintenance]
	repo = ~/rust-lang/rust-clippy
	repo = ~/rust-lang/rust
[includeIf "gitdir:~/recogni/"]
	path = ~/recogni/.gitconfig
[diff]
	colorMoved = zebra
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	features = jjlike
[delta "jjlike"]
	line-numbers = true
	line-numbers-left-format = "{nm:>4}"
	line-numbers-right-format = " {np:>4}: "
	line-numbers-zero-style = dim
	file-style = yellow
	file-decoration-style = none
	file-modified-label = "Modified regular file"
	file-added-label = "Added regular file"
	file-removed-label = "Removed regular file"
	file-renamed-label = "Renamed regular file"
	hunk-header-style = line-number
	hunk-header-decoration-style = none
	hunk-label = "..."
[merge]
	conflictstyle = diff3
